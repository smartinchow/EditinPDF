// Project-wide build settings for EditinPDF. XcodeGen (project.yml) attaches this file to every
// configuration. The bundle identifier and the versions are set here only; the minimum iOS is
// also given to XcodeGen in project.yml (options.deploymentTarget), so change both together.
// The test targets derive their bundle identifiers from PRODUCT_BUNDLE_IDENTIFIER.

PRODUCT_BUNDLE_IDENTIFIER = app.editinpdf.ios
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 2
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// Apple Developer team that signs device and App Store builds (Consultin AI Pty Ltd).
DEVELOPMENT_TEAM = FLZ648PYXU
